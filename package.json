{
  "name": "arcus-ai",
  "version": "1.0.0",
  "description": "A.R.C.U.S. - Automated Resource Control & User Support",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"webpack serve --config webpack.config.js\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "webpack --mode production",
    "pack": "electron-builder --win"
  },
  "author": "A.R.C.U.S. Project",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.162.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "loudness": "^0.4.2",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.arcus.ai",
    "productName": "A.R.C.U.S.",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*"
    ]
  }
}
